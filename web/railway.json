{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "buildCommand": "python data/prepare.py"
    },
    "deploy": {
        "startCommand": "uvicorn api.main:app --host 0.0.0.0 --port $PORT",
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 120
    }
}
