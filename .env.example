# Copy to .env and fill in. NEVER commit .env.
# Values: Supabase Dashboard -> Project Settings -> API Keys / Database -> Connect

SUPABASE_URL=https://cpfymmjjpdmidhtlzgbt.supabase.co

# Safe for browser/frontend code (respects Row Level Security)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server/scripts ONLY - bypasses RLS. Never ship to the frontend.
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres access for Python/ML scripts and bulk imports (session pooler, IPv4-friendly)
DATABASE_URL=postgresql://postgres.cpfymmjjpdmidhtlzgbt:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Lets `npx supabase db push` run without prompting for the password
SUPABASE_DB_PASSWORD=

# Frontend frameworks only read prefixed vars - duplicate the URL + publishable key once the stack is chosen:
# NEXT_PUBLIC_SUPABASE_URL=   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   (Next.js)
# VITE_SUPABASE_URL=          VITE_SUPABASE_PUBLISHABLE_KEY=          (Vite)

# Google OAuth client (docs/AUTH.md). Only for the Supabase CLI (`config push`) / server side - never frontend code.
# Put these two in supabase/.env, not this root .env: `config push` doesn't read the root file.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Gemini, for the explain button and python -m solver.explain. Server/scripts ONLY - never frontend code.
GEMINI_API_KEY=
